<!DOCTYPE html>
<html lang="tj">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Ball Game</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { width: 100vw; height: 100vh; overflow: hidden; background: #1a0033; font-family: 'Segoe UI', Tahoma, sans-serif; user-select: none; }
        
        #canvas-container { width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: 1; }

        #ui-layer {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 2;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
        }

        .hud-panel {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .score-box, .record-box {
            background: rgba(0, 0, 0, 0.6);
            border: 2px solid #ff00ff;
            color: #fff;
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 20px;
            font-weight: bold;
            box-shadow: 0 0 15px rgba(255, 0, 255, 0.4);
            backdrop-filter: blur(5px);
        }

        .screen-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(10, 0, 20, 0.85);
            z-index: 10;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(8px);
        }

        h1 {
            color: #ff00ff;
            font-size: 48px;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-bottom: 10px;
            text-shadow: 0 0 20px rgba(255, 0, 255, 0.6);
            text-align: center;
        }

        p {
            color: #ccc;
            font-size: 18px;
            margin-bottom: 30px;
            text-align: center;
        }

        .btn {
            background: linear-gradient(135deg, #ff00ff, #7700ff);
            color: #fff;
            border: none;
            padding: 15px 40px;
            font-size: 22px;
            font-weight: bold;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 0 20px rgba(255, 0, 255, 0.6);
            transition: transform 0.2s;
            pointer-events: auto;
            text-transform: uppercase;
        }

        .btn:hover { transform: scale(1.05); }

        #mobile-controls {
            display: none;
            width: 100%;
            justify-content: space-between;
            pointer-events: auto;
            padding-bottom: 20px;
        }

        .control-btn {
            width: 90px;
            height: 90px;
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.5);
            border-radius: 50%;
            color: white;
            font-size: 36px;
            display: flex;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }

        @media (max-width: 768px) { #mobile-controls { display: flex; } }
        .hidden { display: none !important; }
    </style>
</head>
<body>

    <div id="canvas-container"></div>

    <div id="ui-layer">
        <div class="hud-panel">
            <div class="score-box">Холҳо: <span id="score-val">0</span></div>
            <div class="record-box">Рекорд: <span id="record-val">0</span></div>
        </div>
        <div id="mobile-controls">
            <div class="control-btn" id="left-btn">←</div>
            <div class="control-btn" id="right-btn">→</div>
        </div>
    </div>

    <div id="main-menu" class="screen-overlay">
        <h1>3D Ball Game</h1>
        <p>Мӯҳрро ронед, аз монеаҳо гурезед ва хол ҷамъ кунед!</p>
        <button class="btn" onclick="startGame()">Оғози Бозӣ</button>
    </div>

    <div id="gameover-screen" class="screen-overlay hidden">
        <h1>Бозӣ Тамом Шуд!</h1>
        <p>Холҳои ҷамъшуда: <span id="final-score">0</span></p>
        <button class="btn" onclick="restartGame()">Боз Аз Нав</button>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    <script>
        let scene, camera, renderer, ball, road;
        let obstacles = [];
        let gameStarted = false, isGameOver = false;
        let score = 0, gameSpeed = 0.5;
        let highScore = localStorage.getItem('ball_game_highscore') || 0;
        let moveLeft = false, moveRight = false;

        document.getElementById('record-val').innerText = highScore;

        function initThree() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x1a0033);
            scene.fog = new THREE.FogExp2(0x1a0033, 0.02);

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 4, 8);
            camera.lookAt(0, 0, -2);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            document.getElementById('canvas-container').appendChild(renderer.domElement);

            scene.add(new THREE.AmbientLight(0xffffff, 0.7));
            const dirLight = new THREE.DirectionalLight(0xff00ff, 0.8);
            dirLight.position.set(10, 20, 10);
            scene.add(dirLight);

            // Платформа (Роҳ)
            const roadGeo = new THREE.PlaneGeometry(8, 300);
            const roadMat = new THREE.MeshStandardMaterial({ color: 0x330066, roughness: 0.5 });
            road = new THREE.Mesh(roadGeo, roadMat);
            road.rotation.x = -Math.PI / 2;
            road.position.z = -100;
            scene.add(road);

            // Тӯб (Мяч)
            const ballGeo = new THREE.SphereGeometry(0.6, 32, 32);
            const ballMat = new THREE.MeshStandardMaterial({ color: 0x00ffff, metalness: 0.5, roughness: 0.1 });
            ball = new THREE.Mesh(ballGeo, ballMat);
            ball.position.set(0, 0.6, 2);
            scene.add(ball);

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        }

        function spawnObstacle() {
            if (!gameStarted || isGameOver) return;

            const obsGeo = new THREE.BoxGeometry(1.2, 1.2, 1.2);
            const obsMat = new THREE.MeshStandardMaterial({ color: 0xff3300 });
            const obs = new THREE.Mesh(obsGeo, obsMat);

            const lanes = [-2.5, 0, 2.5];
            obs.position.x = lanes[Math.floor(Math.random() * lanes.length)];
            obs.position.y = 0.6;
            obs.position.z = -100;

            scene.add(obs);
            obstacles.push(obs);

            setTimeout(spawnObstacle, Math.max(800, 1800 - (score * 5)));
        }

        window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft' || e.key === 'a') moveLeft = true;
            if (e.key === 'ArrowRight' || e.key === 'd') moveRight = true;
        });
        window.addEventListener('keyup', (e) => {
            if (e.key === 'ArrowLeft' || e.key === 'a') moveLeft = false;
            if (e.key === 'ArrowRight' || e.key === 'd') moveRight = false;
        });

        const leftBtn = document.getElementById('left-btn');
        const rightBtn = document.getElementById('right-btn');
        leftBtn.addEventListener('touchstart', () => { moveLeft = true; });
        leftBtn.addEventListener('touchend', () => { moveLeft = false; });
        rightBtn.addEventListener('touchstart', () => { moveRight = true; });
        rightBtn.addEventListener('touchend', () => { moveRight = false; });

        function animate() {
            if (!gameStarted) return;
            requestAnimationFrame(animate);

            if (!isGameOver) {
                if (moveLeft && ball.position.x > -3) ball.position.x -= 0.15;
                if (moveRight && ball.position.x < 3) ball.position.x += 0.15;

                // Меғелондани тӯб
                ball.rotation.z -= 0.1;

                for (let i = obstacles.length - 1; i >= 0; i--) {
                    obstacles[i].position.z += gameSpeed;

                    // Санҷиши бархӯрд
                    if (Math.abs(ball.position.x - obstacles[i].position.x) < 1.0 &&
                        Math.abs(ball.position.z - obstacles[i].position.z) < 1.0) {
                        triggerGameOver();
                    }

                    if (obstacles[i].position.z > 5) {
                        scene.remove(obstacles[i]);
                        obstacles.splice(i, 1);
                        score += 10;
                        document.getElementById('score-val').innerText = score;
                        gameSpeed = 0.5 + Math.floor(score / 100) * 0.1;
                    }
                }
            }
            renderer.render(scene, camera);
        }

        function startGame() {
            document.getElementById('main-menu').classList.add('hidden');
            gameStarted = true;
            isGameOver = false;
            score = 0;
            gameSpeed = 0.5;
            document.getElementById('score-val').innerText = score;
            animate();
            setTimeout(spawnObstacle, 1500);
        }

        function triggerGameOver() {
            isGameOver = true;
            document.getElementById('final-score').innerText = score;
            document.getElementById('gameover-screen').classList.remove('hidden');

            if (score > highScore) {
                highScore = score;
                localStorage.setItem('ball_game_highscore', highScore);
                document.getElementById('record-val').innerText = highScore;
            }
        }

        function restartGame() {
            obstacles.forEach(obs => scene.remove(obs));
            obstacles = [];
            ball.position.x = 0;
            document.getElementById('gameover-screen').classList.add('hidden');
            startGame();
        }

        window.onload = initThree;
    </script>
</body>
</html>
